{
  "name": "octorelease",
  "private": true,
  "description": "Extensible GitHub action to publish semantic releases.",
  "bin": "dist/index.js",
  "scripts": {
    "build": "npx license-check-and-add add && tsc -b --force",
    "lint": "npx @biomejs/biome check --diagnostic-level=warn --write packages script",
    "pack": "npm run pack --workspaces",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typedoc": "typedoc --plugin typedoc-plugin-markdown --out docs/typedoc packages/core/src/index.ts",
    "watch": "tsc -w",
    "all": "npm run build && npm run lint && npm run pack && npm test",
    "prepare": "husky && node patchEsmOnly.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zowe-actions/octorelease.git"
  },
  "keywords": [],
  "author": "t1m0thyj",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "script"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/node": "^22.9.0",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint-plugin-license-header": "^0.9.0",
    "husky": "^9.0.11",
    "license-check-and-add": "^4.0.5",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
